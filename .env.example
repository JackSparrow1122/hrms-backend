# ==============================================================================
ETIMETRACK_ENABLED=false
ETIMETRACK_DB_HOST=192.168.0.185
ETIMETRACK_DB_PORT=1433
# If using a named instance (e.g. SQLEXPRESS), specify it below; otherwise leave empty
ETIMETRACK_DB_INSTANCE=
ETIMETRACK_DB_NAME=etimetracklite1
ETIMETRACK_DB_USER=essl
ETIMETRACK_DB_PASSWORD=essl
ETIMETRACK_LOGIN_TIMEOUT=5
ETIMETRACK_TRUST_CERT=true

# ==============================================================================
# Biometric Sync Controls (Kept strictly false until authorized)
# ==============================================================================
