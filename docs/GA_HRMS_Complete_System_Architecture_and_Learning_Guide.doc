                </tr>
                <tr>
                    <td><strong>Organization</strong></td>
                    <td><span class="tag tag-post">POST</span></td>
                    <td><code>/api/v1/organization/branches</code></td>
                    <td>Admin / HR</td>
                    <td>Naya office/branch location create karo</td>
                </tr>
                <tr>
                    <td><strong>Organization</strong></td>
                    <td><span class="tag tag-post">POST</span></td>
                    <td><code>/api/v1/organization/departments</code></td>
                    <td>Admin / HR</td>
                    <td>IT, HR, Finance departments add karo</td>
                </tr>
                <tr>
                    <td><strong>Organization</strong></td>
                    <td><span class="tag tag-post">POST</span></td>
                    <td><code>/api/v1/organization/designations</code></td>
                    <td>Admin / HR</td>
                    <td>Designations (Software Engineer, Manager) add karo</td>
                </tr>
                <tr>
                    <td><strong>Employee</strong></td>
                    <td><span class="tag tag-post">POST</span></td>
                    <td><code>/api/v1/employees</code></td>
                    <td>Admin / HR</td>
                    <td>Employee onboarding + Auto login user account</td>
                </tr>
                <tr>
                    <td><strong>Employee</strong></td>
                    <td><span class="tag tag-get">GET</span></td>
                    <td><code>/api/v1/employees</code></td>
